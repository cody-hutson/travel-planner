# Personal trip data — never tracked.
# Contents, not the directory: `trips/` alone would also ignore trips/README.md,
# and git cannot re-include a file whose parent dir is excluded. Guarded by
# scripts/test-publish-guard.sh group K — do not "simplify" these two lines.
trips/*
!trips/README.md

# Repo-scoped analysis workspace — operator working material, never committed.
# Audits, reviews and gap analyses ABOUT this repo, in dated <name>-YYYY-MM-DD/
# subfolders. Same shape as trips/ above and for the same reason: contents, not the
# directory, so the signpost README survives while everything beside it stays local.
# Rooted (leading /) so only the workspace at the repo root is caught — a future
# docs/analysis/ is not silently swallowed. Guarded by
# scripts/test-publish-guard.sh group Q — do not "simplify" these two lines.
/analysis/*
!/analysis/README.md

# macOS
.DS_Store

# Editor / IDE
.claude/launch.json
.vscode/
.idea/

# Environment
.env
.env.local
.env.*.local
